generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Device {
  deviceId         String   @id @map("device_id")
  registeredAt     DateTime @default(now()) @db.Timestamptz @map("registered_at")
  dailyRecordLimit Int?     @map("daily_record_limit")

  @@map("devices")
}

model CallCount {
  deviceId String   @map("device_id")
  date     DateTime @db.Date
  type     CallCountType @default(TRANSCRIPTION)
  count    Int      @default(1)

  @@unique([deviceId, date, type])
  @@map("call_counts")
}

model RegistrationAttempt {
  ip    String
  date  DateTime @db.Date
  count Int      @default(1)

  @@unique([ip, date])
  // Backs the retention prune (DELETE WHERE date < cutoff); the composite
  // unique index above can't serve a date-only range scan.
  @@index([date])
  @@map("registration_attempts")
}

enum CallCountType {
  TRANSCRIPTION
  CLEANUP
  TAG
}
