# wrait-backend environment variables.
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# All values below are placeholders — do not use them in production.

# --- Required ---

# Postgres connection string (pooled). Used by Prisma at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Shared secret required on all non-public routes (sent as the X-Proxy-Secret header).
PROXY_SECRET="your-proxy-secret"

# HMAC key used to sign and verify device tokens.
DEVICE_TOKEN_SECRET="your-device-token-secret"

# Deepgram API key (speech-to-text).
DEEPGRAM_API_KEY="your-deepgram-api-key"

# OpenAI API key (transcript cleanup).
OPENAI_API_KEY="your-openai-api-key"

# Typesafe API key (tagging).
TYPESAFE_API_KEY="your-typesafe-api-key"

# --- Optional ---

# Direct (unpooled) Postgres connection string. Used by prisma.config.ts when set,
# falling back to DATABASE_URL. Needed for some Prisma setups (e.g. Prisma <5.10).
# DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/dbname?sslmode=require"

# Node environment: development | production | test. Defaults to the platform value.
# NODE_ENV="development"

# Per-IP, per-UTC-day cap on tokenless registrations. Default: 10.
# MAX_REGISTRATIONS_PER_IP_PER_DAY="10"

# Require signed device tokens on quota endpoints. Default: true (strict).
# Set to "false" only during a migration window to also accept legacy X-Device-Id.
# REQUIRE_DEVICE_TOKEN="true"
